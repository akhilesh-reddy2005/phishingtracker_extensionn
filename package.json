{
  "name": "phishing-tracker-extension",
  "version": "1.0.0",
  "description": "Real-time phishing detection Chrome extension",
  "scripts": {
    "build": "esbuild src/background.ts src/content.ts src/popup.ts src/history.ts --bundle --outdir=dist --platform=browser --target=chrome100",
    "watch": "esbuild src/background.ts src/content.ts src/popup.ts src/history.ts --bundle --outdir=dist --platform=browser --target=chrome100 --watch",
    "dev": "npm run build && npm run watch",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.233",
    "@types/node": "^20.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.0.0"
  }
}
